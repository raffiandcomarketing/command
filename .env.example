# ============ Database ============
# PostgreSQL connection string (Railway Postgres in production)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ============ Auth ============
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The public URL of the app, e.g. https://command-production.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# ============ Bootstrap admin (used by `npm run db:seed`) ============
# The seed creates/rotates this admin account. No default credentials exist.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""   # min 10 chars, upper + lower + number
ADMIN_NAME="Administrator"

# ============ Secrets encryption (webhook signing secrets etc.) ============
# Any long random string; used to derive an AES-256-GCM key.
APP_ENCRYPTION_KEY=""

# ============ Seed behaviour ============
# SEED_DEMO_DATA=true            # opt-in demo CRM data (non-production only)
# SEED_FORCE_RESET=true          # destructive reset (blocked in production
#                                # unless SEED_ALLOW_PRODUCTION_RESET=true)

# ============ Logging ============
# LOG_LEVEL=info                 # debug | info | warn | error

# ============ Local testing without Prisma native engines ============
# PRISMA_PG_ADAPTER=1            # use pg driver adapter + WASM engine (tests)
